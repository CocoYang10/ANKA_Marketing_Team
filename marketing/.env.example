# Copy this file to .env and fill values locally. Never commit .env or credential JSON.

# Google Analytics
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=./credentials/ga4-service-account.json
# Purchase tracking was repaired in production around this date.
GA4_TRUSTED_FROM=2026-07-23

# MailerLite
MAILERLITE_API_KEY=

# Meta
META_ACCESS_TOKEN=
META_PAGE_ID=
# Keep the currently validated version until Facebook App Review confirms an upgrade.
META_GRAPH_VERSION=v19.0

# TikTok Business API
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_SECRET=
TIKTOK_REDIRECT_URI=https://anka.africa
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_ADVERTISER_ID=

# Private API used by the internal dashboard
# Generate long random values. Do not put these in GitHub Pages.
ANKA_DASHBOARD_API_KEY=
ANKA_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ANKA_PUBLIC_BASE_URL=http://localhost:8000
ANKA_TOKEN_STORE=./working/private/tiktok_tokens.json
ANKA_SNAPSHOT_PATH=./demo/data/marketing_snapshot.json

# Optional AI analysis. Server-side use only; never expose this in the dashboard.
ANTHROPIC_API_KEY=
